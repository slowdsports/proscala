# Documentos adjuntos de los procesos: nunca se sirven directamente,
# solo a través de adjuntos.php (que valida la sesión y el acceso al proceso)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
